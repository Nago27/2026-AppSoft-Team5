@page "/home"

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject TodoApiService TodoApi
@inject CharacterApiService CharacterApi

@using TodoRPG.Web.Client.Components.Home
@using TodoRPG.Web.Client.Models
@using TodoRPG.Web.Client.Services

<PageTitle>LAST SURVIVAL - SHELTER DOSSIER</PageTitle>

<div class="bunker-terminal">
    <div class="scanlines"></div>

    <header class="terminal-header">
        <div>
            <div class="system-title">SHELTER SURVIVAL DOSSIER</div>
            <div class="system-subtitle">SECTOR-04 / DANGER ZONE / BUNKER_CORE_ACCESS</div>
        </div>

        <div class="resource-panel">
            <div class="res-item">
                <span class="res-label">LEVEL</span>
                <span class="res-value">@Character.Level</span>
            </div>

            <div class="res-item">
                <span class="res-label">SUPPLY</span>
                <span class="res-value">@Character.Supply</span>
            </div>
        </div>

        <img src="/images/decals/classified-stamp.png" alt="CLASSIFIED" class="header-stamp" />
    </header>

    <main class="terminal-body">
        <CharacterStatusPanel Character="@Character"
                              UserName="@userName"
                              UserId="@userId"
                              SectorProgressRefreshKey="@sectorProgressRefreshKey" />
    </main>

    <TodoMissionLog Todos="@Todos"
                    Categories="@Categories"
                    SelectedCategory="@selectedCategory"
                    IsLoading="@isLoading"
                    ErrorMessage="@todoErrorMessage"
                    OnCreate="@CreateTodo"
                    OnUpdate="@UpdateTodo"
                    OnDelete="@DeleteTodo"
                    OnCompletedChanged="@ToggleTodoCompleted"
                    OnCategorySelected="@SelectCategory" />

    <RewardEffect Show="@showRewardEffect"
                  Message="@effectMessage" />
</div>

@code {
    private readonly CharacterStatus Character = new();
    private readonly IReadOnlyList<string> Categories = TodoCategories.Values;

    private string? userId;
    private string userName = string.Empty;
    private bool isLoading = true;
    private string? todoErrorMessage;
    private int sectorProgressRefreshKey;

    private string selectedCategory = "전체";
    private List<TodoItemDto> Todos = new();

    private bool showRewardEffect;
    private string effectMessage = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        userId = await JS.InvokeAsync<string?>(
            "sessionStorage.getItem",
            "todoRpg_user_id"
        );

        userName = await JS.InvokeAsync<string?>(
            "sessionStorage.getItem",
            "todoRpg_user_name"
        ) ?? string.Empty;

        if (string.IsNullOrWhiteSpace(userId))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(userName))
        {
            userName = userId;
        }

        await LoadTodos();
        await LoadCharacter();
        sectorProgressRefreshKey++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadCharacter()
    {
        var currentUserId = GetCurrentUserIdOrRedirect();

        if (currentUserId is null)
        {
            return;
        }

        try
        {
            var character = await CharacterApi.GetByUserAsync(currentUserId);

            if (character is null)
            {
                todoErrorMessage = "캐릭터 정보를 불러오지 못했습니다.";
                return;
            }

            ApplyCharacterToViewModel(character);
        }
        catch (Exception ex)
        {
            todoErrorMessage = $"캐릭터 정보를 불러오지 못했습니다: {ex.Message}";
        }
    }

    private async Task LoadTodos()
    {
        var currentUserId = GetCurrentUserIdOrRedirect();

        if (currentUserId is null)
        {
            return;
        }

        isLoading = true;
        todoErrorMessage = null;

        try
        {
            Todos = await TodoApi.GetByUserAsync(currentUserId);
        }
        catch (Exception ex)
        {
            todoErrorMessage = $"Todo 목록을 불러오지 못했습니다: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyCharacterToViewModel(CharacterDto character)
    {
        Character.Level = character.Level;
        Character.Exp = character.Experience;
        Character.MaxExp = GetRequiredExperience(character.Level);
        Character.Supply = character.Coin;

        Character.Strength = character.Strength;
        Character.Intelligence = character.Intelligence;
        Character.Luck = character.Fortune;
        Character.Hp = character.Health;
        Character.MaxHp = character.MaxHealth <= 0 ? 100 : character.MaxHealth;

        Character.Title = GetCharacterTitle(character.Level);
    }

    private static int GetRequiredExperience(int level)
    {
        return (int)Math.Floor(90 + (10 * level) + (0.5 * level * level));
    }

    private static string GetCharacterTitle(int level)
    {
        return level switch
        {
            >= 20 => "심층 구역 생존자",
            >= 10 => "구역 정비 생존자",
            >= 5 => "숙련 생존자",
            _ => "벙커 신입 생존자"
        };
    }

    private async Task<bool> CreateTodo(TodoCreateModel model)
    {
        var currentUserId = GetCurrentUserIdOrRedirect();

        if (currentUserId is null)
        {
            return false;
        }

        todoErrorMessage = null;

        var request = new CreateTodoRequest
        {
            UserId = currentUserId,
            Title = model.Title.Trim(),
            Category = model.Category,
            DueDate = model.DueDate
        };

        try
        {
            var createdTodo = await TodoApi.CreateAsync(request);

            if (createdTodo is not null)
            {
                Todos.Insert(0, createdTodo);
            }
            else
            {
                await LoadTodos();
            }

            await LoadCharacter();
            sectorProgressRefreshKey++;

            return true;
        }
        catch (Exception ex)
        {
            todoErrorMessage = $"Todo 추가 중 오류가 발생했습니다: {ex.Message}";
            return false;
        }
    }

    private async Task<bool> UpdateTodo(TodoEditModel model)
    {
        var currentUserId = GetCurrentUserIdOrRedirect();

        if (currentUserId is null)
        {
            return false;
        }

        var target = Todos.FirstOrDefault(todo => todo.Id == model.Id);

        if (target is null)
        {
            todoErrorMessage = "수정할 Todo를 찾지 못했습니다.";
            return false;
        }

        if (target.IsCompleted)
        {
            todoErrorMessage = "완료된 Todo는 수정할 수 없습니다.";
            return false;
        }

        todoErrorMessage = null;

        var request = new UpdateTodoRequest
        {
            UserId = currentUserId,
            Title = model.Title.Trim(),
            Category = model.Category,
            IsCompleted = target.IsCompleted,
            DueDate = model.DueDate
        };

        try
        {
            await TodoApi.UpdateAsync(model.Id, request);

            target.Title = request.Title;
            target.Category = request.Category;
            target.DueDate = request.DueDate;

            return true;
        }
        catch (Exception ex)
        {
            todoErrorMessage = $"Todo 수정 중 오류가 발생했습니다: {ex.Message}";
            return false;
        }
    }

    private async Task ToggleTodoCompleted(TodoCompletedChange change)
    {
        var currentUserId = GetCurrentUserIdOrRedirect();

        if (currentUserId is null)
        {
            return;
        }

        var todo = Todos.FirstOrDefault(item => item.Id == change.TodoId);

        if (todo is null)
        {
            todoErrorMessage = "상태를 변경할 Todo를 찾지 못했습니다.";
            return;
        }

        if (todo.IsCompleted || !change.IsCompleted)
        {
            return;
        }

        var previousValue = todo.IsCompleted;

        todoErrorMessage = null;

        try
        {
            var request = new SetTodoCompletedRequest
            {
                UserId = currentUserId,
                IsCompleted = change.IsCompleted
            };

            var result = await TodoApi.SetCompletedAsync(todo.Id, request);

            if (result is null)
            {
                todo.IsCompleted = previousValue;
                todoErrorMessage = "Todo 완료 처리 응답을 받지 못했습니다.";
                return;
            }

            ApplyTodoFromResponse(todo, result.TodoItem);
            ApplyCharacterToViewModel(result.Character);
            sectorProgressRefreshKey++;

            if (change.IsCompleted && !previousValue)
            {
                await ShowTodoCompleteEffect(
                    todo,
                    result.Reward.Message
                );
            }
        }
        catch (Exception ex)
        {
            todo.IsCompleted = previousValue;
            todoErrorMessage = $"Todo 상태 변경 중 오류가 발생했습니다: {ex.Message}";
        }
    }

    private async Task DeleteTodo(int id)
    {
        var currentUserId = GetCurrentUserIdOrRedirect();

        if (currentUserId is null)
        {
            return;
        }

        var target = Todos.FirstOrDefault(todo => todo.Id == id);

        if (target?.IsCompleted == true)
        {
            todoErrorMessage = "완료된 Todo는 삭제할 수 없습니다.";
            return;
        }

        todoErrorMessage = null;

        try
        {
            await TodoApi.DeleteAsync(id, currentUserId);

            if (target is not null)
            {
                Todos.Remove(target);
            }
        }
        catch (Exception ex)
        {
            todoErrorMessage = $"Todo 삭제 중 오류가 발생했습니다: {ex.Message}";
        }
    }

    private static void ApplyTodoFromResponse(TodoItemDto target, TodoItemDto source)
    {
        target.Title = source.Title;
        target.Category = source.Category;
        target.IsCompleted = source.IsCompleted;
        target.CreatedAt = source.CreatedAt;
        target.CompletedAt = source.CompletedAt;
        target.DueDate = source.DueDate;
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
    }

    private async Task ShowTodoCompleteEffect(TodoItemDto todo, string? rewardMessage)
    {
        effectMessage = string.IsNullOrWhiteSpace(rewardMessage)
            ? TodoCategories.GetCompleteEffectMessage(todo.Category)
            : rewardMessage;

        showRewardEffect = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(1500);

        showRewardEffect = false;
        await InvokeAsync(StateHasChanged);
    }

    private string? GetCurrentUserIdOrRedirect()
    {
        if (!string.IsNullOrWhiteSpace(userId))
        {
            return userId;
        }

        Navigation.NavigateTo("/login", forceLoad: true);
        return null;
    }
}
