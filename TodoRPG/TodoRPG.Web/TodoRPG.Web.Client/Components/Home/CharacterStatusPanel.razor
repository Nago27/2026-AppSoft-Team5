@using TodoRPG.Web.Client.Models

<section class="monitor-section">
    <div class="section-tag">FIELD VIEW</div>

    <div class="monitor-content">
        <div class="depth-indicator">B@(10 - Character.Level)F / EXIT ROUTE</div>

        <div class="character-container">
            <img src="/images/survivor.png"
                 alt="Survivor character"
                 class="survivor-character" />
            <div class="char-shadow"></div>
        </div>

        <div class="monitor-warning">LOW LIGHT / FILTER REQUIRED / AREA UNSTABLE</div>
    </div>

    <div class="survivor-note">
        <strong>@DisplayUserName</strong>
        <span>@Character.Title</span>
    </div>
</section>

<aside class="stats-aside">
    <h2>SURVIVAL PARAMS</h2>

    <div class="vitals-group">
        <div class="vital-row">
            <div class="vital-info">
                <span class="vital-name">FILTER HP</span>
                <span class="vital-num">@Character.Hp / @Character.MaxHp</span>
            </div>

            <div class="gauge-container hp">
                <div class="gauge-fill" style="width: @(Character.HpPercent)%"></div>
            </div>
        </div>

        <div class="vital-row">
            <div class="vital-info">
                <span class="vital-name">LOAD EXP</span>
                <span class="vital-num">@Character.Exp / @Character.MaxExp</span>
            </div>

            <div class="gauge-container exp">
                <div class="gauge-fill" style="width: @(Character.ExpPercent)%"></div>
            </div>
        </div>
    </div>

    <div class="params-grid">
        <div class="param-box param-str">
            <img class="param-note-bg" src="/images/stats/stat-note-4.png" alt="" />

            <div class="param-content">
                <span class="p-label">STR</span>
                <span class="p-value">@Character.Strength</span>
                <span class="p-desc">근력</span>
            </div>
        </div>

        <div class="param-box param-int">
            <img class="param-note-bg" src="/images/stats/stat-note-1.png" alt="" />

            <div class="param-content">
                <span class="p-label">INT</span>
                <span class="p-value">@Character.Intelligence</span>
                <span class="p-desc">지능</span>
            </div>
        </div>

        <div class="param-box param-sta">
            <img class="param-note-bg" src="/images/stats/stat-note-3.png" alt="" />

            <div class="param-content">
                <span class="p-label">STA</span>
                <span class="p-value">@Character.MaxHp</span>
                <span class="p-desc">최대 체력</span>
            </div>
        </div>

        <div class="param-box param-luk">
            <img class="param-note-bg" src="/images/stats/stat-note-2.png" alt="" />

            <div class="param-content">
                <span class="p-label">LUK</span>
                <span class="p-value">@Character.Luck</span>
                <span class="p-desc">행운</span>
            </div>
        </div>
    </div>

    <div class="system-memo">
        <strong>MEMO</strong>
        <p>
            미션을 완료하면 생존 자원과 능력치가 증가합니다.<br />
            <span class="memo-warning">
                <span class="warning-mark">!</span>
                업무 미션은 보급품 보상이 크지만 체력이 일부 감소합니다.
            </span>
        </p>
    </div>
</aside>

@code {
    [Parameter]
    public CharacterStatus Character { get; set; } = new();

    [Parameter]
    public string UserName { get; set; } = string.Empty;

    private string DisplayUserName => string.IsNullOrWhiteSpace(UserName)
        ? "UNKNOWN USER"
        : UserName;
}
